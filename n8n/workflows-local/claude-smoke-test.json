      "name": "Bridge Health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.CLAUDE_BRIDGE_URL }}/health",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
