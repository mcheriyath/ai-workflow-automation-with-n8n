    },
    {
      "id": "736893ee-4b44-5688-b76f-ffbb60e88a20",
      "name": "Job: Ping Claude",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "return [{ json: {\n  kind: 'claude',\n  label: 'smoke test',\n  prompt: 'Reply with exactly: PONG',\n  cwd: 'smoke',\n  timeoutMin: 3,\n  model: 'haiku',\n} }];\n"
      }
    },
    {
      "id": "5705bef4-0660-5148-bede-f1e450ef7a25",
      "name": "Run Claude Job",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "__CLAUDE_JOB_WORKFLOW_ID__"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "45f3cd3b-5912-54d2-9fb3-9ba6683510cb",
      "name": "Assert PONG",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const health = $('Bridge Health').first().json;\nconst job = $input.first().json;\nconst reply = String(job.result ?? '').trim();\nif (reply !== 'PONG') throw new Error(`expected \"PONG\" from Claude, got: ${JSON.stringify(reply).slice(0, 500)}`);\nreturn [{ json: {\n  ok: true,\n  claudeVersion: health.claudeVersion,\n  permissionMode: health.permissionMode,\n  reply,\n  costUsd: job.costUsd,\n  sessionId: job.sessionId,\n} }];\n"
      }
    }
  ],
