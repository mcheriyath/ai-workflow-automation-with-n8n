            "position": [
                680,
                300
            ],
            "parameters": {
                "language": "javaScript",
                "jsCode": "const results = $input.first().json.QueryResult.Results || [];\nif (results.length === 0) {\n  return [{ json: { text: 'No Rally stories currently assigned to you.' } }];\n}\nconst lines = results.map(r => `\\u2022 *${r.FormattedID}* ${r.Name} _(${r.ScheduleState})_`);\nreturn [{ json: { text: `*Your assigned Rally stories (${results.length}):*\\n${lines.join('\\n')}` } }];"
            }
